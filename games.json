/* Find a game guide by ID */
window.getSTGameGuide = function (id) {
  return window.ST_GAME_GUIDES.find(game => game.id === id);
};

/* Safe text helper */
window.stEscapeHTML = function (value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[char]);
};
